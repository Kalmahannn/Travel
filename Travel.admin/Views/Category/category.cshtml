@model List<Category>

@{
    ViewData["Title"] = "Справочник Hotel";
    ViewData["Description"] = "список Hotel";
}
<table class="table table-striped table-bordered table-advance table-hover">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (Category item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a href="@Url.Action("EditCategory", "Category", new{id=item.Id})">edit</a>
                </td>
                <td>
                    <a href="@Url.Action("DeleteCategory", "Category", new{id=item.Id})">delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />
<a href="@Url.Action("Create", "Category")" class="btn btn-default">Add Hotel</a>