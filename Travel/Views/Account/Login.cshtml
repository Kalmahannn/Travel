@model UserModel
@{
    ViewData["Title"] = "Кіру";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}
<style>
    .form-container {
        max-width: 400px;
        margin: 60px auto;
        padding: 30px;
        background: #fff;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        border-radius: 8px;
        font-family: 'Segoe UI', sans-serif;
    }

        .form-container h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            font-weight: 600;
            margin-bottom: 5px;
            display: block;
            color: #555;
        }

    .form-control {
        height: 45px;
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        transition: 0.3s;
    }

        .form-control:focus {
            border-color: #5b9bd5;
            outline: none;
        }

    .btn-primary {
        background-color: #5b9bd5;
        border: none;
        width: 100%;
        padding: 10px;
        color: white;
        border-radius: 6px;
        font-weight: bold;
        transition: 0.3s;
        cursor: pointer;
    }

        .btn-primary:hover {
            background-color: #407ab6;
        }

    .form-footer {
        text-align: center;
        margin-top: 15px;
        font-size: 14px;
    }
</style>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">Кіру</h2>

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Логин</label>
                    <input asp-for="Username" class="form-control" placeholder="Логин енгізіңіз" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Құпия сөз</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Құпия сөз енгізіңіз" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100">Кіру</button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Register" asp-controller="Account">Тіркелу</a>
                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary btn-sm ms-2">Басты бетке оралу</a>
            </div>
        </div>
    </div>
</div>
