@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.Razor
@using Microsoft.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IViewLocalizer Localizer

@* <h1>@Localizer["WelcomeText2"]</h1> *@


@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- start banner Area -->
<section class="banner-area relative">
	<div class="overlay overlay-bg"></div>
	<div class="container">
		<div class="row fullscreen align-items-center justify-content-between">
			<div class="col-lg-6 col-md-6 banner-left">
				<h6 class="text-white">@Localizer["away"]</h6>
				<h1 class="text-white">@Localizer["Magical Travel"]</h1>
				<p class="text-white">
					@Localizer["If"]
				</p>
				<a href="#" class="primary-btn text-uppercase">>@Localizer["Get Started"]</a>
			</div>
			<div class="col-lg-4 col-md-6 banner-right">
				<ul class="nav nav-tabs" id="myTab" role="tablist">
					<li class="nav-item">
						<a class="nav-link active" id="flight-tab" data-toggle="tab" href="#flight" role="tab" aria-controls="flight" aria-selected="true">@Localizer["Flights"]</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" id="hotel-tab" data-toggle="tab" href="#hotel" role="tab" aria-controls="hotel" aria-selected="false">@Localizer["Hotels"]</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" id="holiday-tab" data-toggle="tab" href="#holiday" role="tab" aria-controls="holiday" aria-selected="false">@Localizer["Holidays"]</a>
					</li>
				</ul>
				<div class="tab-content" id="myTabContent">
					<div class="tab-pane fade show active" id="flight" role="tabpanel" aria-labelledby="flight-tab">
						<form class="form-wrap">
							<input type="text" class="form-control" name="name" placeholder="@Localizer["From"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["From"]'">
							<input type="text" class="form-control" name="to" placeholder="@Localizer["To"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["To"]'">
							<input type="text" class="form-control date-picker" name="start" placeholder="@Localizer["Start"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Start"]'">
							<input type="text" class="form-control date-picker" name="return" placeholder="@Localizer["Return"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Return"]'">
							<input type="number" min="1" max="20" class="form-control" name="adults" placeholder="@Localizer["Adults"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Adults"]'">
							<input type="number" min="1" max="20" class="form-control" name="child" placeholder="@Localizer["Child"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Child"]'">
							<a href="#" class="primary-btn text-uppercase">@Localizer["Search flights"]</a>
						</form>

					</div>
					<div class="tab-pane fade" id="hotel" role="tabpanel" aria-labelledby="hotel-tab">
						<form class="form-wrap">
							<input type="text" class="form-control" name="name" placeholder="@Localizer["From"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["From"]'">
							<input type="text" class="form-control" name="to" placeholder="@Localizer["To"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["To"]'">
							<input type="text" class="form-control date-picker" name="start" placeholder="@Localizer["Start"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Start"]'">
							<input type="text" class="form-control date-picker" name="return" placeholder="@Localizer["Return"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Return"]'">
							<input type="number" min="1" max="20" class="form-control" name="adults" placeholder="@Localizer["Adults"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Adults"]'">
							<input type="number" min="1" max="20" class="form-control" name="child" placeholder="@Localizer["Child"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Child"]'">
							<a href="#" class="primary-btn text-uppercase">@Localizer["Search flights"]</a>
						</form>

					</div>
					<div class="tab-pane fade" id="holiday" role="tabpanel" aria-labelledby="holiday-tab">
						<form class="form-wrap">
							<input type="text" class="form-control" name="name" placeholder="@Localizer["From"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["From"]'">
							<input type="text" class="form-control" name="to" placeholder="@Localizer["To"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["To"]'">
							<input type="text" class="form-control date-picker" name="start" placeholder="@Localizer["Start"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Start"]'">
							<input type="text" class="form-control date-picker" name="return" placeholder="@Localizer["Return"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Return"]'">
							<input type="number" min="1" max="20" class="form-control" name="adults" placeholder="@Localizer["Adults"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Adults"]'">
							<input type="number" min="1" max="20" class="form-control" name="child" placeholder="@Localizer["Child"]" onfocus="this.placeholder = ''" onblur="this.placeholder = '@Localizer["Child"]'">
							<a href="#" class="primary-btn text-uppercase">@Localizer["Search flights"]</a>
						</form>

					</div>
				</div>
			</div>
		</div>
	</div>
</section>
